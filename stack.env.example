# Backend settings for the full-stack Compose setup (docker-compose.yml).
# Copy to stack.env (git-ignored) and fill in. Never commit real values.
# Generate secrets with:  openssl rand -hex 32

# Required
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Credential encryption (required to connect integrations). Format: <id>:<base64 32-byte key>
# Generate a key with:  openssl rand -base64 32   (e.g. ENCRYPTION_KEYS=k1:<key>, ENCRYPTION_ACTIVE_KEY_ID=k1)
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=

# Optional integrations (leave empty to keep them "not available on this server").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Optional AI steps: "anthropic" with a key (the fake provider is refused in production).
AI_PROVIDER=
AI_API_KEY=
