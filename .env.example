# Base URL for API calls. Keep /api/v1: the Vite dev proxy (and nginx in production) forwards /api to the backend on the same origin.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=FlowForge
# Dev only: where the Vite dev server proxies /api (default http://localhost:3000).
# VITE_PROXY_TARGET=http://localhost:3100
